def collect_nat_gateways(session, region, account_id):
    """
    Collect NAT Gateway information across all VPCs in a region.
    Includes Subnet Name, VPC Name, attached IPs, and InUse status.
    Fully read-only.
    """
    print(f"[START] NAT Gateway collection for {account_id}/{region}")
    try:
        client = session.client("ec2", region_name=region)

        # Describe NAT Gateways
        nat_response = client.describe_nat_gateways()
        nat_gateways = nat_response.get("NatGateways", [])

        # Describe Subnets to map subnetId -> subnetName, vpcId
        subnet_response = client.describe_subnets()
        subnet_map = {s["SubnetId"]: {t["Key"]: t["Value"] for t in s.get("Tags", [])} for s in subnet_response.get("Subnets", [])}

        # Describe VPCs to map vpcId -> vpcName
        vpc_response = client.describe_vpcs()
        vpc_name_map = {}
        for v in vpc_response.get("Vpcs", []):
            vpc_tags = {t["Key"]: t["Value"] for t in v.get("Tags", [])}
            vpc_name_map[v["VpcId"]] = vpc_tags.get("Name", "")

        rows = []

        for nat in nat_gateways:
            nat_id = nat["NatGatewayId"]
            vpc_id = nat.get("VpcId", "")
            subnet_id = nat.get("SubnetId", "")
            state = nat.get("State", "")
            tags = {t["Key"]: t["Value"] for t in nat.get("Tags", []) if t["Key"] in required_tags}

            # NAT Name
            nat_name = ""
            for t in nat.get("Tags", []):
                if t["Key"] == "Name":
                    nat_name = t["Value"]

            # Subnet and VPC Names
            subnet_name = subnet_map.get(subnet_id, {}).get("Name", "")
            vpc_name = vpc_name_map.get(vpc_id, "")

            # IP details
            public_ips = []
            private_ips = []
            elastic_ips = []

            for addr in nat.get("NatGatewayAddresses", []):
                if addr.get("PublicIp"):
                    public_ips.append(addr["PublicIp"])
                if addr.get("PrivateIp"):
                    private_ips.append(addr["PrivateIp"])
                if addr.get("AllocationId"):
                    elastic_ips.append(addr["AllocationId"])

            in_use = state.lower() == "available"

            row = {
                "Service": "NATGateway",
                "Account": account_id,
                "Region": region,
                "NatGatewayId": nat_id,
                "NatGatewayName": nat_name,
                "VpcId": vpc_id,
                "VpcName": vpc_name,
                "SubnetId": subnet_id,
                "SubnetName": subnet_name,
                "State": state,
                "InUse": in_use,
                "PublicIPs": "; ".join(public_ips) if public_ips else "-",
                "PrivateIPs": "; ".join(private_ips) if private_ips else "-",
                "ElasticIPs": "; ".join(elastic_ips) if elastic_ips else "-",
                **{t: tags.get(t, "") for t in required_tags},
            }

            rows.append(row)

        print(f"[DONE] NAT Gateway collection for {account_id}/{region} - {len(rows)} records")
        return rows

    except botocore.exceptions.ClientError as e:
        print(f"[ERROR] NAT Gateway collection failed in {region}: {e}")
        return []
