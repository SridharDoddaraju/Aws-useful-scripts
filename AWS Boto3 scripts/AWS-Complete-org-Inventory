#------------EC2
def collect_ec2(session, region, account_id):
    print(f"[START] EC2 collection for {account_id}/{region}")
    try:
        client = session.client("ec2", region_name=region)
        iam_client = session.client("iam", region_name=region)
        rows = []

        # Collect all volumes once with paginator
        volume_info = {}
        try:
            pages = safe_paginate(client, "describe_volumes")
            for page in pages:
                for v in page.get("Volumes", []):
                    volume_info[v["VolumeId"]] = {
                        "Size": v.get("Size"),
                        "VolumeType": v.get("VolumeType", ""),
                        "Encrypted": v.get("Encrypted", False)
                    }
        except Exception as e:
            print(f"[WARN] Could not fetch all EBS volumes for {account_id}/{region}: {e}")

        # Pre-fetch subnet and VPC names for lookup
        subnet_names = {}
        vpc_names = {}
        try:
            subnets = safe_paginate(client, "describe_subnets")
            for page in subnets:
                for s in page.get("Subnets", []):
                    name_tag = ""
                    for t in s.get("Tags", []):
                        if t["Key"].lower() == "name":
                            name_tag = t["Value"]
                            break
                    subnet_names[s["SubnetId"]] = name_tag

            vpcs = safe_paginate(client, "describe_vpcs")
            for page in vpcs:
                for v in page.get("Vpcs", []):
                    name_tag = ""
                    for t in v.get("Tags", []):
                        if t["Key"].lower() == "name":
                            name_tag = t["Value"]
                            break
                    vpc_names[v["VpcId"]] = name_tag
        except Exception as e:
            print(f"[WARN] Could not fetch VPC/Subnet names for {account_id}/{region}: {e}")

        # Use paginator for instances
        try:
            pages = safe_paginate(client, "describe_instances")
            for page in pages:
                for r in page.get("Reservations", []):
                    for i in r.get("Instances", []):
                        # Tags
                        tags = {t["Key"]: t["Value"] for t in i.get("Tags", []) if t["Key"] in required_tags}

                        # Attached volumes
                        volumes = i.get("BlockDeviceMappings", [])
                        volume_ids = [v["Ebs"]["VolumeId"] for v in volumes if "Ebs" in v and v["Ebs"].get("VolumeId")]
                        volume_sizes = [str(volume_info[v]["Size"]) if v in volume_info and volume_info[v].get("Size") is not None else "" for v in volume_ids]
                        volume_types = [volume_info[v]["VolumeType"] if v in volume_info else "" for v in volume_ids]
                        volume_encrypted = [str(volume_info[v]["Encrypted"]) if v in volume_info else "" for v in volume_ids]

                        # Network info
                        vpc_id = i.get("VpcId", "")
                        subnet_id = i.get("SubnetId", "")
                        vpc_name = vpc_names.get(vpc_id, "")
                        subnet_name = subnet_names.get(subnet_id, "")

                        # Security Groups
                        sg_info = i.get("SecurityGroups", [])
                        sg_ids = [sg.get("GroupId", "") for sg in sg_info]
                        sg_names = [sg.get("GroupName", "") for sg in sg_info]

                        # IAM Role
                        iam_role_name = ""
                        iam_role_arn = ""
                        if "IamInstanceProfile" in i and i["IamInstanceProfile"]:
                            profile_arn = i["IamInstanceProfile"].get("Arn", "")
                            try:
                                profile_name = profile_arn.split("/")[-1]
                                resp = iam_client.get_instance_profile(InstanceProfileName=profile_name)
                                roles = resp["InstanceProfile"].get("Roles", [])
                                if roles:
                                    iam_role_name = roles[0]["RoleName"]
                                    iam_role_arn = roles[0]["Arn"]
                            except Exception:
                                iam_role_name = profile_arn.split("/")[-1]

                        row = {
                            "Service": "EC2",
                            "Account": account_id,
                            "Region": region,
                            "Instance ID": i["InstanceId"],
                            "AZ": i.get("Placement", {}).get("AvailabilityZone", ""),
                            "State": i.get("State", {}).get("Name", ""),
                            "Private IP": i.get("PrivateIpAddress", ""),
                            "Public IP": i.get("PublicIpAddress", ""),
                            "Launchdate": i.get("LaunchTime").strftime("%Y-%m-%d %H:%M:%S") if i.get("LaunchTime") else "",
                            "State Transition Reason": i.get("StateTransitionReason", ""),
                            "Instance Type": i.get("InstanceType", ""),
                            "OS": i.get("Platform", "Linux/UNIX"),
                            "KeyName": i.get("KeyName", ""),

                            # Volumes
                            "Volume IDs": ";".join(volume_ids),
                            "Volume Sizes": ";".join(volume_sizes),
                            "Volume Type": ";".join(volume_types),
                            "Encrypted": ";".join(volume_encrypted),

                            # Network attachments
                            "VPC ID": vpc_id,
                            "VPC Name": vpc_name,
                            "Subnet ID": subnet_id,
                            "Subnet Name": subnet_name,
                            "Security Group IDs": ";".join(sg_ids),
                            "Security Group Names": ";".join(sg_names),

                            # IAM Role
                            "IAM Role Name": iam_role_name,
                            "IAM Role ARN": iam_role_arn,

                            **{tag: tags.get(tag, "") for tag in required_tags}
                        }

                        rows.append(row)
        except botocore.exceptions.ClientError as e:
            print(f"[ERROR] describe_instances failed for {account_id}/{region}: {e}")
        except Exception as e:
            print(f"[ERROR] Unexpected EC2 processing error for {account_id}/{region}: {e}")

        print(f"[DONE] EC2 collection for {account_id}/{region} - {len(rows)} records")
        return rows

    except botocore.exceptions.ClientError as e:
        print(f"[ERROR] EC2 collection failed in {region} for {account_id}: {e}")
        return []


