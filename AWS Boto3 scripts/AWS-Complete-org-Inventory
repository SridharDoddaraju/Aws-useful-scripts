def assume_role(account_id, role_name):
    sts = boto3.client("sts")
    creds = sts.assume_role(
        RoleArn=f"arn:aws:iam::{account_id}:role/{role_name}",
        RoleSessionName="InventorySession"
    )["Credentials"]

    return boto3.Session(
        aws_access_key_id=creds["AccessKeyId"],
        aws_secret_access_key=creds["SecretAccessKey"],
        aws_session_token=creds["SessionToken"]
    )

# ----------------- Helpers -----------------
def get_all_regions(session):
    """
    Return list of region names for this partition, including opt-in regions
    that are either 'opt-in-not-required' or 'opted-in'.
    """
    ec2 = session.client("ec2")
    try:
        resp = ec2.describe_regions(AllRegions=True)
        regions = []
        for r in resp.get("Regions", []):
            optin = r.get("OptInStatus", "opt-in-not-required")
            # include regions that are available or opted-in
            if optin in ("opt-in-not-required", "opted-in"):
                regions.append(r["RegionName"])
        return sorted(regions)
    except botocore.exceptions.ClientError as e:
        print(f"[ERROR] describe_regions failed: {e}")
        # fallback to a safe common regions list if describe_regions fails
        return ["us-east-1", "us-east-2", "us-west-1", "us-west-2", "af-south-1", "ap-east-1", "ap-south-1", "ap-south-2",
"ap-southeast-1", "ap-southeast-2", "ap-southeast-3", "ap-southeast-4", "ap-northeast-1", "ap-northeast-2", "ap-northeast-3",
"ca-central-1", "ca-west-1", "eu-central-1", "eu-central-2", "eu-west-1", "eu-west-2", "eu-west-3", "eu-south-1", "eu-south-2" "me-south-1", "me-central-1", "sa-east-1", "il-central-1",
 "us-gov-east-1", "us-gov-west-1", "cn-north-1", "cn-northwest-1"]

def safe_paginate(client, operation_name, **kwargs):
    """
    Utility to use paginator if available, otherwise call operation once.
    Returns an iterator of pages (dict).
    """
    try:
        paginator = client.get_paginator(operation_name)
        return paginator.paginate(**kwargs)
    except (botocore.exceptions.OperationNotPageableError, botocore.exceptions.ClientError):
        # operation not pageable or client error: do a single call and wrap in list
        try:
            fn = getattr(client, operation_name)
            return [fn(**kwargs)]
        except Exception as e:
            raise

