                        "PerformanceMode": fs.get("PerformanceMode", ""),
                        "ThroughputMode": fs.get("ThroughputMode", ""),
                        "ProvisionedThroughputInMibps": fs.get("ProvisionedThroughputInMibps", ""),
                        "Encrypted": "Yes" if fs.get("Encrypted", False) else "No",
                        "KMS Key ID": fs.get("KmsKeyId", ""),
                        "LifeCycleState": fs.get("LifeCycleState", ""),
                        "CreationTime": fs.get("CreationTime").strftime("%Y-%m-%d %H:%M:%S") if fs.get("CreationTime") else "",
                        "NumberOfMountTargets": fs.get("NumberOfMountTargets", ""),
                        "SizeInBytes": fs.get("SizeInBytes", {}).get("Value", "") if fs.get("SizeInBytes") else "",
                        "SizeInBytes_Timestamp": fs.get("SizeInBytes", {}).get("Timestamp").strftime("%Y-%m-%d %H:%M:%S") if fs.get("SizeInBytes") and fs.get("SizeInBytes").get("Timestamp") else "",
                        "MountTargets": "; ".join(mount_targets),
                        **{tag: tags.get(tag, "") for tag in required_tags}
                    }
                    rows.append(row)
        except botocore.exceptions.ClientError as e:
            print(f"[ERROR] describe_file_systems failed for {account_id}/{region}: {e}")
        except Exception as e:
            print(f"[ERROR] Unexpected EFS processing error for {account_id}/{region}: {e}")

        print(f"[DONE] EFS collection for {account_id}/{region} - {len(rows)} records")
        return rows
    except botocore.exceptions.ClientError as e:
        print(f"[ERROR] EFS collection failed in {region} for {account_id}: {e}")
