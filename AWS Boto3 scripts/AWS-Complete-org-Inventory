# ----------------- DynamoDB -----------------
def collect_dynamodb(session, region, account_id):
    """
    Collect DynamoDB table details for a given account and region.
    Includes throughput, encryption, PITR, and tags.
    Fully read-only.
    """
    print(f"[START] DynamoDB collection for {account_id}/{region}")
    try:
        client = session.client("dynamodb", region_name=region)

        # List tables
        table_names = []
        paginator = client.get_paginator("list_tables")
        for page in paginator.paginate():
            table_names.extend(page.get("TableNames", []))

        rows = []

        for table_name in table_names:
            try:
                table_desc = client.describe_table(TableName=table_name)["Table"]

                # Extract main properties
                table_status = table_desc.get("TableStatus", "")
                item_count = table_desc.get("ItemCount", 0)
                size_bytes = table_desc.get("TableSizeBytes", 0)
                billing_mode = table_desc.get("BillingModeSummary", {}).get("BillingMode", "PROVISIONED")

                read_capacity = table_desc.get("ProvisionedThroughput", {}).get("ReadCapacityUnits", "")
                write_capacity = table_desc.get("ProvisionedThroughput", {}).get("WriteCapacityUnits", "")

                # Encryption info
                sse_desc = table_desc.get("SSEDescription", {})
                encryption_type = sse_desc.get("SSEType", "")
                kms_key_arn = sse_desc.get("KMSMasterKeyArn", "")
                sse_status = sse_desc.get("Status", "")

                # PITR (Point-in-time recovery)
                try:
                    pitr_resp = client.describe_continuous_backups(TableName=table_name)
                    pitr_status = pitr_resp["ContinuousBackupsDescription"]["PointInTimeRecoveryDescription"].get("PointInTimeRecoveryStatus", "DISABLED")
                except Exception:
                    pitr_status = "UNKNOWN"

                # Tags
                tags = {}
                try:
                    arn = table_desc.get("TableArn", "")
                    if arn:
                        tag_resp = client.list_tags_of_resource(ResourceArn=arn)
                        tag_list = tag_resp.get("Tags", [])
                        tags = {t["Key"]: t["Value"] for t in tag_list if t["Key"] in required_tags}
                except Exception:
                    pass

                in_use = table_status.lower() == "active"

                row = {
                    "Service": "DynamoDB",
                    "Account": account_id,
                    "Region": region,
                    "TableName": table_name,
                    "Status": table_status,
                    "InUse": in_use,
                    "ItemCount": item_count,
                    "SizeBytes": size_bytes,
                    "BillingMode": billing_mode,
                    "ReadCapacityUnits": read_capacity,
                    "WriteCapacityUnits": write_capacity,
                    "EncryptionType": encryption_type,
                    "KMSKeyArn": kms_key_arn,
                    "SSEStatus": sse_status,
                    "PITRStatus": pitr_status,
                    **{t: tags.get(t, "") for t in required_tags},
                }

                rows.append(row)

            except botocore.exceptions.ClientError as e:
                print(f"[WARN] Failed to describe DynamoDB table {table_name}: {e}")

        print(f"[DONE] DynamoDB collection for {account_id}/{region} - {len(rows)} records")
        return rows

    except botocore.exceptions.ClientError as e:
        print(f"[ERROR] DynamoDB collection failed in {region}: {e}")
        return []
#---------------------------------Event Bridge---------------
def collect_eventbridge(session, region, account_id):
    """
    Collect Amazon EventBridge info (Event Buses, Rules, and Targets)
    with consistent formatting for inventory reporting.
    """
    print(f"[START] EventBridge collection for {account_id}/{region}")
    rows = []

    try:
        client = session.client("events", region_name=region)

        # ---------- Collect Event Buses ----------
        try:
            pages = safe_paginate(client, "list_event_buses")
            for page in pages:
                for bus in page.get("EventBuses", []):
                    bus_name = bus.get("Name", "")
                    bus_arn = bus.get("Arn", "")
                    tags = {}

                    # Get tags
                    try:
                        tag_resp = client.list_tags_for_resource(ResourceARN=bus_arn)
                        tags = {t["Key"]: t["Value"] for t in tag_resp.get("Tags", [])}
                    except Exception:
                        pass

                    row = {
                        "Service": "EventBridge",
                        "Account": account_id,
                        "Region": region,
                        "ResourceType": "EventBus",
                        "BusName": bus_name,
                        "BusArn": bus_arn,
                        "Description": bus.get("Description", ""),
                        "ResourceName": bus_name,
                        "ResourceId": bus_arn,
                        "InUse": True,
                        **{t: tags.get(t, "") for t in required_tags},
                    }
                    rows.append(row)
        except Exception as e:
            print(f"[ERROR] EventBridge buses collection failed for {account_id}/{region}: {e}")

        # ---------- Collect Rules per Bus ----------
        try:
            buses = [b["Name"] for b in client.list_event_buses().get("EventBuses", [])]
            for bus_name in buses:
                rule_pages = safe_paginate(client, "list_rules", EventBusName=bus_name)
                for rule_page in rule_pages:
                    for rule in rule_page.get("Rules", []):
                        rule_name = rule.get("Name", "")
                        rule_arn = rule.get("Arn", "")
                        tags = {}

                        # Get tags
                        try:
                            tag_resp = client.list_tags_for_resource(ResourceARN=rule_arn)
                            tags = {t["Key"]: t["Value"] for t in tag_resp.get("Tags", [])}
                        except Exception:
                            pass

                        # Get targets
                        target_names = []
                        try:
                            targets = client.list_targets_by_rule(Rule=rule_name, EventBusName=bus_name)
                            target_names = [t.get("Arn", "") for t in targets.get("Targets", [])]
                        except Exception:
                            pass

                        row = {
                            "Service": "EventBridge",
                            "Account": account_id,
                            "Region": region,
                            "ResourceType": "Rule",
                            "BusName": bus_name,
                            "RuleName": rule_name,
                            "RuleArn": rule_arn,
                            "EventPattern": json.dumps(rule.get("EventPattern", {})),
                            "State": rule.get("State", ""),
                            "ScheduleExpression": rule.get("ScheduleExpression", ""),
                            "Targets": ", ".join(target_names) if target_names else "-",
                            "ResourceName": rule_name,
                            "ResourceId": rule_arn,
                            "InUse": bool(target_names),
                            **{t: tags.get(t, "") for t in required_tags},
                        }
                        rows.append(row)
        except Exception as e:
            print(f"[ERROR] EventBridge rules collection failed for {account_id}/{region}: {e}")

        print(f"[DONE] EventBridge collection for {account_id}/{region} - {len(rows)} records")
        return rows

    except botocore.exceptions.ClientError as e:
        print(f"[ERROR] EventBridge collection failed in {region} for {account_id}: {e}")
        return []
    except Exception as e:
        print(f"[ERROR] Unexpected EventBridge processing error for {account_id}/{region}: {e}")
        return []


# ------------------------- IAM -------------------------------

def collect_iam(session, region, account_id):
    """
    Collect IAM Users, Roles, Groups, and Policies info.
    Outputs separate columns with tags and logical flags for activity/in-use.
    """
    print(f"[START] IAM collection for {account_id}")
    rows = []
    try:
        client = session.client("iam")

        # --- Collect IAM Users ---
        try:
            users_pages = safe_paginate(client, "list_users")
            for users_page in users_pages:
                for user in users_page.get("Users", []):
                    user_name = user.get("UserName", "")
                    arn = user.get("Arn", "")
                    create_date = str(user.get("CreateDate", ""))
                    password_last_used = str(user.get("PasswordLastUsed", ""))
                    tags = {}

                    try:
                        tag_resp = client.list_user_tags(UserName=user_name)
                        tags = {t["Key"]: t["Value"] for t in tag_resp.get("Tags", []) if t["Key"] in required_tags}
                    except Exception:
                        pass

                    row = {
                        "Service": "IAM",
                        "Account": account_id,
                        "Region": "global",
                        "Type": "User",
                        "Name": user_name,
                        "Arn": arn,
                        "CreatedDate": create_date,
                        "PasswordLastUsed": password_last_used,
                        "InUse": bool(password_last_used and password_last_used != "None"),
                        "ResourceName": user_name,
                        "ResourceId": arn,
                        **{t: tags.get(t, "") for t in required_tags},
                    }
                    rows.append(row)
        except Exception as e:
            print(f"[ERROR] IAM User collection failed for {account_id}: {e}")

        # --- Collect IAM Roles ---
        try:
            roles_pages = safe_paginate(client, "list_roles")
            for roles_page in roles_pages:
                for role in roles_page.get("Roles", []):
                    role_name = role.get("RoleName", "")
                    arn = role.get("Arn", "")
                    create_date = str(role.get("CreateDate", ""))
                    tags = {}

                    try:
                        tag_resp = client.list_role_tags(RoleName=role_name)
                        tags = {t["Key"]: t["Value"] for t in tag_resp.get("Tags", []) if t["Key"] in required_tags}
                    except Exception:
                        pass

                    # Determine if the role is actively used
                    in_use = bool(role.get("RoleLastUsed", {}).get("LastUsedDate"))

                    row = {
                        "Service": "IAM",
                        "Account": account_id,
                        "Region": "global",
                        "Type": "Role",
                        "Name": role_name,
                        "Arn": arn,
                        "CreatedDate": create_date,
                        "LastUsedDate": str(role.get("RoleLastUsed", {}).get("LastUsedDate", "")),
                        "InUse": in_use,
                        "ResourceName": role_name,
                        "ResourceId": arn,
                        **{t: tags.get(t, "") for t in required_tags},
                    }
                    rows.append(row)
        except Exception as e:
            print(f"[ERROR] IAM Role collection failed for {account_id}: {e}")

        # --- Collect IAM Groups ---
        try:
            groups_pages = safe_paginate(client, "list_groups")
            for groups_page in groups_pages:
                for group in groups_page.get("Groups", []):
                    group_name = group.get("GroupName", "")
                    arn = group.get("Arn", "")
                    create_date = str(group.get("CreateDate", ""))

                    row = {
                        "Service": "IAM",
                        "Account": account_id,
                        "Region": "global",
                        "Type": "Group",
                        "Name": group_name,
                        "Arn": arn,
                        "CreatedDate": create_date,
                        "InUse": "-",  # Groups have no direct "use" metric
                        "ResourceName": group_name,
                        "ResourceId": arn,
                        **{t: "" for t in required_tags},
                    }
                    rows.append(row)
        except Exception as e:
            print(f"[ERROR] IAM Group collection failed for {account_id}: {e}")

        # --- Collect IAM Policies (only customer-managed) ---
        try:
            policies_pages = safe_paginate(client, "list_policies", Scope="Local")
            for policies_page in policies_pages:
                for policy in policies_page.get("Policies", []):
                    policy_name = policy.get("PolicyName", "")
                    arn = policy.get("Arn", "")
                    create_date = str(policy.get("CreateDate", ""))

                    row = {
                        "Service": "IAM",
                        "Account": account_id,
                        "Region": "global",
                        "Type": "Policy",
                        "Name": policy_name,
                        "Arn": arn,
                        "CreatedDate": create_date,
                        "InUse": "-",  # You could extend this with policy attachment info if needed
                        "ResourceName": policy_name,
                        "ResourceId": arn,
                        **{t: "" for t in required_tags},
                    }
                    rows.append(row)
        except Exception as e:
            print(f"[ERROR] IAM Policy collection failed for {account_id}: {e}")

        print(f"[DONE] IAM collection for {account_id} - {len(rows)} records")

        return rows

    except botocore.exceptions.ClientError as e:
        print(f"[ERROR] IAM client creation failed for {account_id}: {e}")
        return []
    except Exception as e:
        print(f"[ERROR] Unexpected IAM processing error for {account_id}: {e}")
        return []
# ------------------------- API Gateway -------------------------------
def collect_apigateway(session, region, account_id):
    """
    Collect API Gateway (REST, HTTP, WebSocket) info.
    Includes API details, stages, and tags with consistent output format.
    """
    print(f"[START] API Gateway collection for {account_id}/{region}")
    rows = []

    try:
        # ---------- API Gateway v1 (REST APIs) ----------
        try:
            client_v1 = session.client("apigateway", region_name=region)
            pages_v1 = safe_paginate(client_v1, "get_rest_apis")

            for page in pages_v1:
                for api in page.get("items", []):
                    api_id = api.get("id", "")
                    api_name = api.get("name", "")
                    description = api.get("description", "")
                    created_date = str(api.get("createdDate", ""))
                    endpoint_conf = json.dumps(api.get("endpointConfiguration", {}))
                    tags = {}
                    stage_names = []

                    # Tags
                    try:
                        tag_resp = client_v1.get_tags(resourceArn=f"arn:aws:apigateway:{region}::/restapis/{api_id}")
                        tags = tag_resp.get("tags", {})
                    except Exception:
                        pass

                    # Stages
                    try:
                        stage_resp = client_v1.get_stages(restApiId=api_id)
                        stage_names = [s.get("stageName", "") for s in stage_resp.get("item", [])]
                    except Exception:
                        pass

                    row = {
                        "Service": "API Gateway",
                        "Account": account_id,
                        "Region": region,
                        "Type": "REST",
                        "APIName": api_name,
                        "APIId": api_id,
                        "Description": description,
                        "CreatedDate": created_date,
                        "Stages": ", ".join(stage_names) if stage_names else "-",
                        "EndpointConfiguration": endpoint_conf,
                        "InUse": bool(stage_names),
                        "ResourceName": api_name,
                        "ResourceId": api_id,
                        **{t: tags.get(t, "") for t in required_tags},
                    }
                    rows.append(row)
        except Exception as e:
            print(f"[ERROR] API Gateway v1 (REST) collection failed for {account_id}/{region}: {e}")

        # ---------- API Gateway v2 (HTTP / WebSocket APIs) ----------
        try:
            client_v2 = session.client("apigatewayv2", region_name=region)
            pages_v2 = safe_paginate(client_v2, "get_apis")

            for page in pages_v2:
                for api in page.get("Items", []):
                    api_id = api.get("ApiId", "")
                    api_name = api.get("Name", "")
                    description = api.get("Description", "")
                    protocol = api.get("ProtocolType", "")
                    version = api.get("Version", "")
                    route_expr = api.get("RouteSelectionExpression", "")
                    created_date = str(api.get("CreatedDate", ""))
                    tags = {}
                    stage_names = []

                    # Tags
                    try:
                        tag_resp = client_v2.get_tags(ResourceArn=f"arn:aws:apigateway:{region}::/apis/{api_id}")
                        tags = tag_resp.get("Tags", {})
                    except Exception:
                        pass

                    # Stages
                    try:
                        stage_resp = client_v2.get_stages(ApiId=api_id)
                        stage_names = [s.get("StageName", "") for s in stage_resp.get("Items", [])]
                    except Exception:
                        pass

                    row = {
                        "Service": "API Gateway",
                        "Account": account_id,
                        "Region": region,
                        "Type": protocol,
                        "APIName": api_name,
                        "APIId": api_id,
                        "Description": description,
                        "Version": version,
                        "RouteSelectionExpression": route_expr,
                        "CreatedDate": created_date,
                        "Stages": "; ".join(stage_names) if stage_names else "-",
                        "InUse": bool(stage_names),
                        "ResourceName": api_name,
                        "ResourceId": api_id,
                        **{t: tags.get(t, "") for t in required_tags},
                    }
                    rows.append(row)
        except Exception as e:
            print(f"[ERROR] API Gateway v2 (HTTP/WebSocket) collection failed for {account_id}/{region}: {e}")

        print(f"[DONE] API Gateway collection for {account_id}/{region} - {len(rows)} records")

        return rows

