# ----------------- Redis (ElastiCache) -----------------
def collect_redis(session, region, account_id):
    """
    Collect Redis (ElastiCache) cluster and replication group details.
    Includes endpoints, engine version, VPC, subnet group, SGs, and tags.
    Fully read-only.
    """
    print(f"[START] Redis (ElastiCache) collection for {account_id}/{region}")
    try:
        client = session.client("elasticache", region_name=region)
        ec2_client = session.client("ec2", region_name=region)

        # Describe replication groups and clusters
        rep_groups = client.describe_replication_groups().get("ReplicationGroups", [])
        clusters = client.describe_cache_clusters(ShowCacheNodeInfo=True).get("CacheClusters", [])

        # Describe Subnets and VPCs for mapping
        subnet_groups_resp = client.describe_cache_subnet_groups().get("CacheSubnetGroups", [])
        vpc_map = {}
        subnet_group_map = {}
        for s in subnet_groups_resp:
            subnet_group_map[s["CacheSubnetGroupName"]] = {
                "VpcId": s.get("VpcId", ""),
                "Subnets": [sn["SubnetIdentifier"] for sn in s.get("Subnets", [])],
                "SubnetGroupDescription": s.get("CacheSubnetGroupDescription", "")
            }
            vpc_map[s["VpcId"]] = ""

        # Map VPC IDs to Names
        if vpc_map:
            vpc_resp = ec2_client.describe_vpcs(VpcIds=list(vpc_map.keys()))
            for v in vpc_resp.get("Vpcs", []):
                tags = {t["Key"]: t["Value"] for t in v.get("Tags", [])}
                vpc_map[v["VpcId"]] = tags.get("Name", "")

        rows = []

        for cluster in clusters:
            cluster_id = cluster.get("CacheClusterId", "")
            engine = cluster.get("Engine", "")
            engine_version = cluster.get("EngineVersion", "")
            node_type = cluster.get("CacheNodeType", "")
            num_nodes = cluster.get("NumCacheNodes", 0)
            status = cluster.get("CacheClusterStatus", "")
            replication_group_id = cluster.get("ReplicationGroupId", "")
            subnet_group_name = cluster.get("CacheSubnetGroupName", "")
            security_groups = [sg["SecurityGroupId"] for sg in cluster.get("SecurityGroups", [])]
            azs = [node.get("CustomerAvailabilityZone", "") for node in cluster.get("CacheNodes", [])]
            primary_endpoint = cluster.get("ConfigurationEndpoint", {}).get("Address", "")
            port = cluster.get("ConfigurationEndpoint", {}).get("Port", "")

            # Tags
            tags = {}
            try:
                arn = cluster.get("ARN", "")
                if arn:
                    tag_list = client.list_tags_for_resource(ResourceName=arn).get("TagList", [])
                    tags = {t["Key"]: t["Value"] for t in tag_list if t["Key"] in required_tags}
            except Exception:
                pass

            # Subnet & VPC Info
            subnet_group_info = subnet_group_map.get(subnet_group_name, {})
            vpc_id = subnet_group_info.get("VpcId", "")
            vpc_name = vpc_map.get(vpc_id, "")
            subnet_list = subnet_group_info.get("Subnets", [])

            row = {
                "Service": "Redis",
                "Account": account_id,
                "Region": region,
                "ClusterId": cluster_id,
                "ReplicationGroupId": replication_group_id,
                "Engine": engine,
                "EngineVersion": engine_version,
                "NodeType": node_type,
                "NodeCount": num_nodes,
                "Status": status,
                "VpcId": vpc_id,
                "VpcName": vpc_name,
                "SubnetGroupName": subnet_group_name,
                "Subnets": "; ".join(subnet_list),
                "AvailabilityZones": "; ".join(azs),
                "SecurityGroups": "; ".join(security_groups),
                "PrimaryEndpoint": f"{primary_endpoint}:{port}" if primary_endpoint else "-",
                **{t: tags.get(t, "") for t in required_tags},
            }

            rows.append(row)

        print(f"[DONE] Redis collection for {account_id}/{region} - {len(rows)} records")
        return rows

    except botocore.exceptions.ClientError as e:
        print(f"[ERROR] Redis collection failed in {region}: {e}")
        return []

