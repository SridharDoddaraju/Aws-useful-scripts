def collect_eks(session, region, account_id):
    print(f"[START] EKS collection for {account_id}/{region}")
    try:
        client = session.client("eks", region_name=region)

        # List clusters
        rows = []
        try:
            pages = safe_paginate(client, "list_clusters")
            cluster_names = []
            for page in pages:
                cluster_names.extend(page.get("clusters", []))

            for cname in cluster_names:
                try:
                    resp = client.describe_cluster(name=cname)
                    cluster = resp.get("cluster", {})

                    tags = {k: v for k, v in cluster.get("tags", {}).items() if k in required_tags}

                    # Encryption config
                    kms_key = ""
                    if cluster.get("encryptionConfig"):
                        for enc in cluster["encryptionConfig"]:
                            kms_key = enc.get("provider", {}).get("keyArn", "")

                    row = {
                        "Service": "EKS",
                        "Account": account_id,
                        "Region": region,
                        "ClusterName": cluster.get("name", ""),
                        "ClusterArn": cluster.get("arn", ""),
                        "Version": cluster.get("version", ""),
                        "Status": cluster.get("status", ""),
                        "PlatformVersion": cluster.get("platformVersion", ""),
                       # "Endpoint": cluster.get("endpoint", ""),
                        "RoleArn": cluster.get("roleArn", ""),
                        "VpcId": cluster.get("resourcesVpcConfig", {}).get("vpcId", ""),
                        "SubnetIds": ";".join(cluster.get("resourcesVpcConfig", {}).get("subnetIds", [])),
                        "SecurityGroups": ";".join(cluster.get("resourcesVpcConfig", {}).get("securityGroupIds", [])),
                        "KMS Key ID": kms_key,
                        "CreatedAt": cluster.get("createdAt").strftime("%Y-%m-%d %H:%M:%S") if cluster.get("createdAt") else "",
                        **{tag: tags.get(tag, "") for tag in required_tags}
                    }
                    rows.append(row)
                except Exception as e:
                    print(f"   [WARN] Could not describe cluster {cname} for {account_id}/{region}: {e}")
        except botocore.exceptions.ClientError as e:
            print(f"[ERROR] list_clusters failed for {account_id}/{region}: {e}")

        print(f"[DONE] EKS collection for {account_id}/{region} - {len(rows)} records")
        return rows

    except botocore.exceptions.ClientError as e:
        print(f"[ERROR] EKS collection failed in {region} for {account_id}: {e}")
        return []

