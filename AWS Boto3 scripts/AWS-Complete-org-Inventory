def collect_appsync(session, region, account_id):
    """
    Collect AWS AppSync GraphQL API details.
    Includes endpoints, auth types, logging config, and tags.
    """
    supported_appsync_regions = [
        "us-east-1", "us-west-2", "eu-west-1", "eu-west-2",
        "ap-northeast-1", "ap-south-1", "ap-southeast-1"
    ]
    if region not in supported_appsync_regions:
        print(f"[SKIP] AppSync not supported in {region}")
        return []

    print(f"[START] AppSync collection for {account_id}/{region}")
    rows = []

    try:
        client = session.client("appsync", region_name=region)
        paginator = client.get_paginator("list_graphql_apis")

        for page in paginator.paginate():
            for api in page.get("graphqlApis", []):
                api_id = api.get("apiId")
                arn = api.get("arn")
                name = api.get("name")
                auth_type = api.get("authenticationType")
                uris = api.get("uris", {})
                log_config = api.get("logConfig", {})
                xray_enabled = api.get("xrayEnabled", False)
                additional_auth_types = api.get("additionalAuthenticationProviders", [])
                visibility = api.get("visibility", "PRIVATE")

                # Tags
                tags = {}
                try:
                    tag_resp = client.list_tags_for_resource(resourceArn=arn)
                    tags = tag_resp.get("tags", {})
                except Exception:
                    pass

                # Data sources
                data_sources = []
                try:
                    ds_paginator = client.get_paginator("list_data_sources")
                    for ds_page in ds_paginator.paginate(apiId=api_id):
                        data_sources.extend([ds.get("name") for ds in ds_page.get("dataSources", [])])
                except Exception:
                    pass

                # Resolver count
                resolver_count = 0
                try:
                    types_resp = client.list_types(apiId=api_id, format="SDL")
                    for t in types_resp.get("types", []):
                        type_name = t.get("name")
                        res_paginator = client.get_paginator("list_resolvers")
                        for res_page in res_paginator.paginate(apiId=api_id, typeName=type_name):
                            resolver_count += len(res_page.get("resolvers", []))
                except Exception:
                    pass

                row = {
                    "Service": "AppSync",
                    "Account": account_id,
                    "Region": region,
                    "APIName": name,
                    "APIId": api_id,
                    "ARN": arn,
                    "AuthenticationType": auth_type,
                    "AdditionalAuthTypes": json.dumps(additional_auth_types),
                    "Visibility": visibility,
                    "XRayEnabled": xray_enabled,
                    "Uris": json.dumps(uris),
                    "LogConfig": json.dumps(log_config),
                    "DataSources": "; ".join(data_sources),
                    "ResolverCount": resolver_count,
                    "Created": str(api.get("creationDate", "")),
                    "Modified": str(api.get("lastModifiedDate", "")),
                    "ResourceName": name,
                    "ResourceId": arn,
                    **{t: tags.get(t, "") for t in required_tags},
                }
                rows.append(row)

        print(f"[DONE] AppSync collection for {account_id}/{region} - {len(rows)} records")
        return rows

    except Exception as e:
        print(f"[ERROR] AppSync collection failed in {region} for {account_id}: {e}")
        return []
#----------------------------------------SES (Mail Service) collection
def collect_mail_service(session, region, account_id):
    """
    Collect Amazon Simple Email Service (SES) details.
    Includes identities, configuration sets, DKIM, and quotas.
    """
    supported_ses_regions = ["us-east-1", "us-west-2", "eu-west-1", "ap-south-1"]
    if region not in supported_ses_regions:
        print(f"[SKIP] SES not supported in {region}")
        return []

    print(f"[START] SES (Mail Service) collection for {account_id}/{region}")
    rows = []

    try:
        # Try SESv2 first, fallback to SESv1
        try:
            client = session.client("sesv2", region_name=region)
            paginator = client.get_paginator("list_email_identities")
            v2 = True
        except Exception:
            client = session.client("ses", region_name=region)
            v2 = False

        # Quota
        try:
            quota_resp = client.get_sending_quota() if not v2 else {}
            max_24_hour_send = quota_resp.get("Max24HourSend", 0)
            max_send_rate = quota_resp.get("MaxSendRate", 0)
            sent_last_24_hours = quota_resp.get("SentLast24Hours", 0)
        except Exception:
            max_24_hour_send = max_send_rate = sent_last_24_hours = "N/A"

        # Config sets
        config_sets = []
        try:
            paginator_conf = client.get_paginator("list_configuration_sets")
            for page in paginator_conf.paginate():
                config_sets.extend(page.get("ConfigurationSets", []))
        except Exception:
            pass

        # Identities
        try:
            if v2:
                paginator = client.get_paginator("list_email_identities")
                for page in paginator.paginate():
                    for ident in page.get("EmailIdentities", []):
                        name = ident.get("IdentityName")
                        arn = ident.get("IdentityArn", "")
                        tags = {}
                        try:
                            tag_resp = client.list_tags_for_resource(ResourceArn=arn)
                            tags = {t["Key"]: t["Value"] for t in tag_resp.get("Tags", [])}
                        except Exception:
                            pass

                        row = {
                            "Service": "SES",
                            "Account": account_id,
                            "Region": region,
                            "IdentityName": name,
                            "IdentityType": ident.get("IdentityType", ""),
                            "Verified": ident.get("VerifiedForSendingStatus", False),
                            "DkimStatus": ident.get("DkimAttributes", {}).get("Status", ""),
                            "MailFromDomain": ident.get("MailFromAttributes", {}).get("MailFromDomain", ""),
                            "MailFromStatus": ident.get("MailFromAttributes", {}).get("BehaviorOnMxFailure", ""),
                            "SendingEnabled": ident.get("SendingEnabled", ""),
                            "Max24HourSend": max_24_hour_send,
                            "MaxSendRate": max_send_rate,
                            "SentLast24Hours": sent_last_24_hours,
                            "ConfigurationSets": "; ".join(config_sets),
                            "ResourceName": name,
                            "ResourceId": arn,
                            **{t: tags.get(t, "") for t in required_tags},
                        }
                        rows.append(row)
            else:
                identities = client.list_identities().get("Identities", [])
                for name in identities:
                    row = {
                        "Service": "SES",
                        "Account": account_id,
                        "Region": region,
                        "IdentityName": name,
                        "ResourceName": name,
                        "ResourceId": name,
                        "Max24HourSend": max_24_hour_send,
                        "MaxSendRate": max_send_rate,
                        "SentLast24Hours": sent_last_24_hours,
                        **{t: "" for t in required_tags},
                    }
                    rows.append(row)
        except Exception as e:
            print(f"[ERROR] SES identity listing failed: {e}")

        print(f"[DONE] SES (Mail Service) collection for {account_id}/{region} - {len(rows)} records")
        return rows

    except Exception as e:
        print(f"[ERROR] SES (Mail Service) error for {account_id}/{region}: {e}")
        return []

#------------------AmazonMQ-------------------
def collect_amazon_mq(session, region, account_id):
    """
    Collect Amazon MQ broker details including configurations, engine type, version, users, and tags.
    """
    mq_regions = ["us-east-1", "us-west-2", "eu-west-1", "eu-central-1", "ap-south-1", "ap-southeast-1", "ap-southeast-2"]
    if region not in mq_regions:
        print(f"[SKIP] Amazon MQ not supported in {region}")
        return []

    print(f"[START] Amazon MQ collection for {account_id}/{region}")
    rows = []

    try:
        client = session.client("mq", region_name=region)
        paginator = client.get_paginator("list_brokers")

        for page in paginator.paginate():
            for broker in page.get("BrokerSummaries", []):
                broker_id = broker.get("BrokerId")
                broker_name = broker.get("BrokerName")
                broker_arn = broker.get("BrokerArn")

                try:
                    details = client.describe_broker(BrokerId=broker_id)
                except Exception:
                    details = {}

                tags = {}
                try:
                    tag_resp = client.list_tags(ResourceArn=broker_arn)
                    tags = {k: v for k, v in tag_resp.get("Tags", {}).items()}
                except Exception:
                    pass

                users_list = []
                try:
                    users_resp = client.list_users(BrokerId=broker_id)
                    users_list = [u["Username"] for u in users_resp.get("Users", [])]
                except Exception:
                    pass

                row = {
                    "Service": "AmazonMQ",
                    "Account": account_id,
                    "Region": region,
                    "BrokerId": broker_id,
                    "BrokerName": broker_name,
                    "BrokerArn": broker_arn,
                    "EngineType": broker.get("EngineType", ""),
                    "EngineVersion": broker.get("EngineVersion", ""),
                    "DeploymentMode": broker.get("DeploymentMode", ""),
                    "HostInstanceType": details.get("HostInstanceType", ""),
                    "StorageType": details.get("StorageType", ""),
                    "EncryptionOptions": json.dumps(details.get("EncryptionOptions", {})),
                    "PubliclyAccessible": details.get("PubliclyAccessible", False),
                    "AutoMinorVersionUpgrade": details.get("AutoMinorVersionUpgrade", False),
                    "Users": ", ".join(users_list),
                    "Configurations": json.dumps(details.get("Configurations", {})),
                    "Endpoints": ", ".join(details.get("Endpoints", [])) if details.get("Endpoints") else "",
                    "Logs": json.dumps(details.get("Logs", {})),
                    "Status": broker.get("BrokerState", ""),
                    "Created": str(details.get("Created", "")),
                    "ResourceName": broker_name,
                    "ResourceId": broker_id,
                    **{t: tags.get(t, "") for t in required_tags},
                }
                rows.append(row)

        print(f"[DONE] Amazon MQ collection for {account_id}/{region} - {len(rows)} records")
        return rows

    except Exception as e:
        print(f"[ERROR] Amazon MQ collection failed for {account_id}/{region}: {e}")
        return []

