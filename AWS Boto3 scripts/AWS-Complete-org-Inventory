        rows = []
        try:
            pages = safe_paginate(client, "describe_file_systems")
            for page in pages:
                for fs in page.get("FileSystems", []):
                    tags = {t["Key"]: t["Value"] for t in fs.get("Tags", []) if t["Key"] in required_tags}

