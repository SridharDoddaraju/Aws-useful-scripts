def collect_security_groups(session, region, account_id):
    """
    Collect Security Groups info with attached resources and rule summaries.
    Outputs separate ResourceName and ResourceId columns.
    """
    print(f"[START] Security Groups collection for {account_id}/{region}")
    try:
        client = session.client("ec2", region_name=region)
        rows = []

        try:
            sgs_pages = safe_paginate(client, "describe_security_groups")
            enis_pages = safe_paginate(client, "describe_network_interfaces")

            # Map SG -> list of attached instance IDs
            sg_to_instances = {}
            instance_ids_set = set()
            for enis_page in enis_pages:
                for eni in enis_page.get("NetworkInterfaces", []):
                    for sg in eni.get("Groups", []):
                        sg_id = sg.get("GroupId")
                        inst_id = eni.get("Attachment", {}).get("InstanceId")
                        if sg_id:
                            sg_to_instances.setdefault(sg_id, [])
                            if inst_id:
                                sg_to_instances[sg_id].append(inst_id)
                                instance_ids_set.add(inst_id)

            # Optional: map instance IDs -> Names
            instance_name_map = {}
            if instance_ids_set:
                ec2 = session.client("ec2", region_name=region)
                try:
                    inst_pages = safe_paginate(ec2, "describe_instances", InstanceIds=list(instance_ids_set))
                    for inst_page in inst_pages:
                        for r in inst_page.get("Reservations", []):
                            for i in r.get("Instances", []):
                                name_tag = next((t["Value"] for t in i.get("Tags", []) if t["Key"] == "Name"), "")
                                instance_name_map[i.get("InstanceId")] = name_tag
                except Exception:
                    # if instance lookup fails, continue with empty names
                    pass

            for sgs_page in sgs_pages:
                for sg in sgs_page.get("SecurityGroups", []):
                    # Tags
                    tags = {t["Key"]: t["Value"] for t in sg.get("Tags", []) if t["Key"] in required_tags}

                    # Attached resources (split into two columns)
                    attached_names = []
                    attached_ids = []
                    for inst_id in sg_to_instances.get(sg.get("GroupId"), []):
                        name = instance_name_map.get(inst_id, "")
                        if name:
                            attached_names.append(name)
                        attached_ids.append(inst_id)

                    in_use = bool(attached_ids)

                    # Ingress rules summary
                    ingress_rules = []
                    for rule in sg.get("IpPermissions", []):
                        from_port = str(rule.get("FromPort", "-"))
                        to_port = str(rule.get("ToPort", "-"))
                        protocol = rule.get("IpProtocol", "-")
                        for ipr in rule.get("IpRanges", []):
                            cidr = ipr.get("CidrIp", "")
                            ingress_rules.append(f"{protocol}:{from_port}-{to_port} | {cidr}")

                    # Egress rules summary
                    egress_rules = []
                    for rule in sg.get("IpPermissionsEgress", []):
                        from_port = str(rule.get("FromPort", "-"))
                        to_port = str(rule.get("ToPort", "-"))
                        protocol = rule.get("IpProtocol", "-")
                        for ipr in rule.get("IpRanges", []):
                            cidr = ipr.get("CidrIp", "")
                            egress_rules.append(f"{protocol}:{from_port}-{to_port} | {cidr}")

                    # Check if any rule allows 0.0.0.0/0
                    all_traffic_anywhere = any("0.0.0.0/0" in r for r in ingress_rules + egress_rules)

                    row = {
                        "Service": "SecurityGroup",
                        "Account": account_id,
                        "Region": region,
                        "GroupId": sg.get("GroupId", ""),
                        "GroupName": sg.get("GroupName", ""),
                        "VpcId": sg.get("VpcId", ""),
                        "Description": sg.get("Description", ""),
                        "ResourceName": ", ".join(attached_names) if attached_names else "None",
                        "ResourceId": ", ".join(attached_ids) if attached_ids else "None",
                        "InUse": in_use,
                        "IngressRules": "; ".join(ingress_rules) if ingress_rules else "-",
                        "EgressRules": "; ".join(egress_rules) if egress_rules else "-",
                        "AllTrafficFromAnywhere": all_traffic_anywhere,
                        **{t: tags.get(t, "") for t in required_tags},
                    }

                    rows.append(row)
        except botocore.exceptions.ClientError as e:
            print(f"[ERROR] Security Groups / ENIs retrieval failed for {account_id}/{region}: {e}")
        except Exception as e:
            print(f"[ERROR] Unexpected Security Groups processing error for {account_id}/{region}: {e}")

        print(f"[DONE] Security Groups collection for {account_id}/{region} - {len(rows)} records")
        return rows

    except botocore.exceptions.ClientError as e:
        print(f"[ERROR] Security Groups collection failed in {region} for {account_id}: {e}")
        return []

