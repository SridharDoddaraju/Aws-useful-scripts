        all_services = {svc: [] for svc in service_list}

        with ThreadPoolExecutor(max_workers=15) as executor:
            futures = []

            for region in regions:
                futures.append(executor.submit(collect_service_parallel, session, account_id, region, collect_ec2))
                futures.append(executor.submit(collect_service_parallel, session, account_id, region, collect_ebs))
                futures.append(executor.submit(collect_service_parallel, session, account_id, region, collect_rds))
                futures.append(executor.submit(collect_service_parallel, session, account_id, region, collect_lambda))
                futures.append(executor.submit(collect_service_parallel, session, account_id, region, collect_elb))
                futures.append(executor.submit(collect_service_parallel, session, account_id, region, collect_alb))
                futures.append(executor.submit(collect_service_parallel, session, account_id, region, collect_efs))
                futures.append(executor.submit(collect_service_parallel, session, account_id, region, collect_eks))
                futures.append(executor.submit(collect_service_parallel, session, account_id, region, collect_ebs_snapshots))
                futures.append(executor.submit(collect_service_parallel, session, account_id, region, collect_amis))
                futures.append(executor.submit(collect_service_parallel, session, account_id, region, collect_vpcs))
                futures.append(executor.submit(collect_service_parallel, session, account_id, region, collect_subnets))
                futures.append(executor.submit(collect_service_parallel, session, account_id, region, collect_internet_gateways))
                futures.append(executor.submit(collect_service_parallel, session, account_id, region, collect_eips))
                futures.append(executor.submit(collect_service_parallel, session, account_id, region, collect_security_groups))
                futures.append(executor.submit(collect_service_parallel, session, account_id, region, collect_workspaces))
                futures.append(executor.submit(collect_service_parallel, session, account_id, region, collect_redis))
                futures.append(executor.submit(collect_service_parallel, session, account_id, region, collect_nat_gateways))
                futures.append(executor.submit(collect_service_parallel, session, account_id, region, collect_dynamodb))
                futures.append(executor.submit(collect_service_parallel, session, account_id, region, collect_eventbridge))
                futures.append(executor.submit(collect_service_parallel, session, account_id, region, collect_apigateway))
                futures.append(executor.submit(collect_service_parallel, session, account_id, region, collect_opensearch))
                futures.append(executor.submit(collect_service_parallel, session, account_id, region, collect_appsync))
                futures.append(executor.submit(collect_service_parallel, session, account_id, region, collect_mail_service))
                futures.append(executor.submit(collect_service_parallel, session, account_id, region, collect_amazon_mq))
            # S3 is global
            futures.append(executor.submit(collect_service_parallel, session, account_id, None, collect_s3))
            futures.append(executor.submit(collect_service_parallel, session, account_id, None, collect_iam))

            for future in as_completed(futures):
                try:
                    data = future.result()
                    if data:
                        service_name = data[0]["Service"]
                        if service_name in all_services:
                            all_services[service_name].extend(data)
                        else:
                            # safety: append to a generic bucket if unexpected
                            combined_services.setdefault(service_name, []).extend(data)
                except Exception as e:
                    print(f"[ERROR] Thread failed for account {account_id}: {e}")

        # Merge per-account results into combined_services
        for service_name, data in all_services.items():
            combined_services[service_name].extend(data)

    # Write all accounts into single Excel
    with pd.ExcelWriter(filename, engine='xlsxwriter') as writer:
        for service_name, data in combined_services.items():
            if data:
                pd.DataFrame(data).to_excel(writer, sheet_name=service_name[:31], index=False)
            else:
                pd.DataFrame([{"Info": f"No records found for {service_name}"}]).to_excel(writer, sheet_name=service_name[:31], index=False)

    print(f"\n✅ Inventory saved to {filename}")

if __name__ == "__main__":
    main()

