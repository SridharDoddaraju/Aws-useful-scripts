#--------------------------OpenSearch-----------
def collect_opensearch(session, region, account_id):
    """
    Collect Amazon OpenSearch/Elasticsearch domain details.
    Includes configuration, endpoints, VPC info, and tags.
    """
    print(f"[START] OpenSearch collection for {account_id}/{region}")
    rows = []

    try:
        # Try OpenSearch client first, fallback to Elasticsearch
        try:
            client = session.client("opensearch", region_name=region)
            domains_resp = client.list_domain_names()
        except Exception:
            client = session.client("es", region_name=region)
            domains_resp = client.list_domain_names()

        domain_names = [d["DomainName"] for d in domains_resp.get("DomainNames", [])]

        for domain_name in domain_names:
            try:
                desc = client.describe_domain(DomainName=domain_name)
                domain_status = desc.get("DomainStatus", {})
                arn = domain_status.get("ARN", "")
                tags = {}

                # Tags
                try:
                    tag_resp = client.list_tags(ARN=arn)
                    tags = {t["Key"]: t["Value"] for t in tag_resp.get("TagList", [])}
                except Exception:
                    pass

                vpc_info = domain_status.get("VPCOptions", {})
                vpc_id = vpc_info.get("VPCId", "")
                subnet_ids = "; ".join(vpc_info.get("SubnetIds", [])) if vpc_info.get("SubnetIds") else ""
                security_groups = "; ".join(vpc_info.get("SecurityGroupIds", [])) if vpc_info.get("SecurityGroupIds") else ""

                cluster_config = domain_status.get("ClusterConfig", {})
                instance_type = cluster_config.get("InstanceType", "")
                instance_count = cluster_config.get("InstanceCount", "")
                dedicated_master_enabled = cluster_config.get("DedicatedMasterEnabled", False)
                dedicated_master_type = cluster_config.get("DedicatedMasterType", "")
                dedicated_master_count = cluster_config.get("DedicatedMasterCount", "")

                encryption = domain_status.get("EncryptionAtRestOptions", {}).get("Enabled", False)
                node_to_node_encryption = domain_status.get("NodeToNodeEncryptionOptions", {}).get("Enabled", False)

                endpoint = domain_status.get("Endpoint", "")
                endpoints = domain_status.get("Endpoints", {})

                row = {
                    "Service": "OpenSearch",
                    "Account": account_id,
                    "Region": region,
                    "DomainName": domain_name,
                    "DomainId": domain_status.get("DomainId", ""),
                    "ARN": arn,
                    "EngineVersion": domain_status.get("EngineVersion", ""),
                    "VPCId": vpc_id,
                    "SubnetIds": subnet_ids,
                    "SecurityGroups": security_groups,
                    "InstanceType": instance_type,
                    "InstanceCount": instance_count,
                    "DedicatedMasterEnabled": dedicated_master_enabled,
                    "DedicatedMasterType": dedicated_master_type,
                    "DedicatedMasterCount": dedicated_master_count,
                    "EncryptionAtRestEnabled": encryption,
                    "NodeToNodeEncryptionEnabled": node_to_node_encryption,
                    "Endpoint": endpoint,
                    "AlternateEndpoints": json.dumps(endpoints),
                    "Processing": domain_status.get("Processing", False),
                    "Created": domain_status.get("Created", ""),
                    "Deleted": domain_status.get("Deleted", ""),
                    "InUse": not domain_status.get("Deleted", False),
                    "ResourceName": domain_name,
                    "ResourceId": arn,
                    **{t: tags.get(t, "") for t in required_tags},
                }
                rows.append(row)
            except Exception as e:
                print(f"[ERROR] Describe failed for domain {domain_name}: {e}")

        print(f"[DONE] OpenSearch collection for {account_id}/{region} - {len(rows)} records")
        return rows

    except Exception as e:
        print(f"[ERROR] OpenSearch collection failed for {account_id}/{region}: {e}")
        return []
